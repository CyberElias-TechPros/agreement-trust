# Frontend — leave as /api/v1 to use the Vite proxy to the Cloudflare Worker.
VITE_API_URL=/api/v1
VITE_APP_NAME=TaskContract
# VITE_DEMO_MODE=false

# Cloudflare Worker (local node-server.mjs / wrangler)
# PORT=8787
# JWT_SECRET=generate-with-openssl-rand-hex-48
# APP_URL=http://localhost:8080
# CORS_ORIGINS=http://localhost:8080
