# TaskContract API — environment configuration
# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored: NEVER commit real secrets.

# Port the API listens on
PORT=3001

# MongoDB connection string (Atlas SRV or local)
MONGODB_URI=mongodb://localhost:27017/agreement-trust

# JWT signing secret — generate one with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins (your frontend URL(s))
CORS_ORIGINS=http://localhost:8080

# development | production
NODE_ENV=development
